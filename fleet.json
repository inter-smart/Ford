export interface FleetHero {
  title: string;
  backgroundImage: string;
}

export interface FleetIntro {
  title: string;
  description: string[];
  vehicleImage: string;
  quoteText: string;
  buttonText: string;
  buttonLink: string;
}

export interface FleetCategory {
  id: number;
  name: string;
  slug: string;
}

export interface FleetVehicle {
  id: number;
  name: string;
  image: string;
  category: string;
  link: string;
}

export interface ContactCard {
  id: number;
  icon: string;
  title: string;
  description: string;
  buttonText: string;
  buttonLink: string;
}

export interface FleetData {
  hero: FleetHero;
  intro: FleetIntro;
  categories: FleetCategory[];
  vehicles: FleetVehicle[];
  contactSection: { 
    description: string;
    cards: ContactCard[];
  };
}

